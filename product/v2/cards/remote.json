{
  "label": "Remote",
  "allowInSubpage": true,
  "domains": ["remote"],
  "options": [
    { "name": "up", "label": "Up", "kind": "text", "omitDefault": true },
    { "name": "dn", "label": "Down", "kind": "text", "omitDefault": true },
    { "name": "lt", "label": "Left", "kind": "text", "omitDefault": true },
    { "name": "rt", "label": "Right", "kind": "text", "omitDefault": true },
    { "name": "ok", "label": "OK", "kind": "text", "omitDefault": true },
    { "name": "bk", "label": "Back", "kind": "text", "omitDefault": true },
    { "name": "hm", "label": "Home", "kind": "text", "omitDefault": true },
    { "name": "mn", "label": "Menu", "kind": "text", "omitDefault": true },
    { "name": "vu", "label": "Volume Up", "kind": "text", "omitDefault": true },
    { "name": "vd", "label": "Volume Down", "kind": "text", "omitDefault": true },
    { "name": "mt", "label": "Mute", "kind": "text", "omitDefault": true },
    { "name": "pw", "label": "Power", "kind": "text", "omitDefault": true },
    { "name": "pp", "label": "Play/Pause", "kind": "text", "omitDefault": true },
    { "name": "rw", "label": "Rewind", "kind": "text", "omitDefault": true },
    { "name": "ff", "label": "Fast Forward", "kind": "text", "omitDefault": true },
    { "name": "ro", "label": "Button Order", "kind": "text", "values": ["bk", "hm", "mn", "rw", "pp", "ff", "pw"], "defaultValue": "bk|hm|mn|rw|pp|ff|pw", "omitDefault": true },
    { "name": "nv", "label": "Navigation", "kind": "choice", "values": ["pad", "touch"], "defaultValue": "pad", "omitDefault": true }
  ],
  "normalization": {
    "fields": {
      "entity": { "policy": "keep" }, "label": { "policy": "keep" },
      "icon": { "policy": "default", "value": "Auto" },
      "icon_on": { "policy": "default", "value": "Auto" },
      "sensor": { "policy": "clear" }, "unit": { "policy": "clear" },
      "type": { "policy": "default", "value": "remote" }, "precision": { "policy": "clear" },
      "options": { "policy": "keep" }
    },
    "unknownOptions": "drop",
    "canonicalOptionOrder": ["up", "dn", "lt", "rt", "ok", "bk", "hm", "mn", "vu", "vd", "mt", "pw", "pp", "rw", "ff", "ro", "nv"]
  },
  "default": {
    "entity": "", "label": "", "icon": "Auto", "icon_on": "Auto",
    "sensor": "", "unit": "", "type": "remote", "precision": "",
    "options": "up=up,dn=down,lt=left,rt=right,ok=select,bk=menu,hm=home,vu=volume_up,vd=volume_down,pw=suspend"
  }
}
