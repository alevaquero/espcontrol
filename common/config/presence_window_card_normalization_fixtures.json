    "expected": {
      "entity": "",
      "label": "Front Door",
      "icon": "Door",
      "icon_on": "Door Open",
      "sensor": "binary_sensor.front_door",
      "unit": "",
      "type": "door_window",
      "precision": "door",
      "options": "active_color,sides=both,sensor2=binary_sensor.kitchen_window,label2=Kitchen%2C Window,subtype2=window,active_color2"
    }
  },
  {
    "name": "door window drops second sensor settings without a second sensor",
